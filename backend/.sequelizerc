
import { fileURLToPath } from "node:url";
import path from "node:path";

const filename = fileURLToPath(import.meta.url);
const dirname = path.dirname(filename);

export default {
  config: path.join(dirname, "src/config/sequelize-cli.cjs"),
  "models-path": path.join(dirname, "src/models"),
  "seeders-path": path.join(dirname, "src/seeders"),
  "migrations-path": path.join(dirname, "src/migrations")
};
